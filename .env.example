# Copy to .env (git-ignored). Defaults match compose.yaml.
POSTGRES_DSN=postgresql://cofabriq:cofabriq@localhost:5433/cofabriq
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cofabriq-dev

# Embeddings (step 4): OpenAI text-embedding-3-small
OPENAI_API_KEY=sk-...

# Issues (v1): the repo to triage and a read-only GitHub token.
# Fine-grained token, "Public repositories (read-only)", no other permission.
TARGET_REPO=open-webui/open-webui
GITHUB_TOKEN=github_pat_...

# Draft PRs (`run --apply`, 0.2): a second fine-grained token, "Only select
# repositories" = the playground, Contents and Pull requests read and write,
# nothing else. cofabriq refuses any other repo in code as well.
GITHUB_WRITE_TOKEN=github_pat_...

# Coding agent (0.2): Claude Code in headless mode (`claude` on PATH), billed
# to this key. AGENT_MODEL / AGENT_EFFORT override claude-opus-5-5 / medium.
ANTHROPIC_API_KEY=sk-ant-...
